<?xml version='1.0' encoding='UTF-8'?>
<!--
  Hand written test data for this package. Not derived from OpenStreetMap:
  the ids, coordinates and names are made up, and it is covered by the same
  licence as the rest of the package.

  It covers what the osm-testdata grid does not: metadata that differs from
  one element to the next, an edit with no user on it, tags that need UTF-8,
  a relation with a member of every type including another relation, and both
  named and empty roles.

  Rebuild it by running osmium cat over this file, writing the .osm.pbf
  next to it.
-->
<osm version="0.6" generator="hand written">
